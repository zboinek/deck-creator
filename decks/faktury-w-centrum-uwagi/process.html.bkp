          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6">
            <circle cx="12" cy="6" r="3"/><line x1="12" y1="9" x2="12" y2="18" stroke-linecap="round"/>
          </svg>
        </span>
        <div class="legend-text">
          <strong>Aktor</strong>
          <span>Użytkownik wchodzący z systemem w interakcję</span>
