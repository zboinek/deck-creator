      <!-- ─── FAZA 6 — POWRÓT DO IGNACEGO ─── -->
      <div class="phase">
        <div class="phase-label"><span class="phase-num">06</span> Powrót do bohatera</div>

        <div class="row">
          <div class="node node--accent" style="text-align: center;">
            <div class="node-title">Ignacy widzi wyniki</div>
            <div class="node-sub">Piątek · 17:23</div>
            <p class="node-desc">1840 plików nadal istnieje. Ale tym razem rozumie je system — nie tylko Ignacy.</p>
